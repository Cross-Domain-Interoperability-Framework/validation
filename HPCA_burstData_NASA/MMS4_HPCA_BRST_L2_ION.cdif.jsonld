  "schema:distribution": [
    {
      "@type": [
        "schema:DataDownload",
        "cdi:StructuredDataSet"
      ],
      "schema:name": "Individual burst CDF granule (direct download)",
      "schema:contentUrl": "https://lasp.colorado.edu/mms/sdc/public/data/mms4/hpca/brst/l2/ion/2015/09/01/mms4_hpca_brst_l2_ion_20150901121114_v4.1.0.cdf",
      "schema:encodingFormat": [
        "application/x-cdf"
      ],
      "schema:contentSize": "3351068",
      "schema:description": "A single CDF granule covering one burst interval (one file per burst), stored under the year/month/day access directories given in schema:url. The contentUrl shown is the first verified granule for 2015-09-01 (3,351,068 bytes); for any other burst, construct the URL with the download action below once the burst start time (YYYYMMDDhhmmss) and processing version are known (from the SDC file API or HAPI). The CDF variables inside each granule are the fields described by schema:variableMeasured.",
      "schema:provider": [
        {
          "@type": [
            "schema:Organization"
          ],
          "schema:name": "Laboratory for Atmospheric and Space Physics, Science Data Center (LASP SDC), University of Colorado Boulder"
        }
      ],
      "schema:potentialAction": [
        {
          "@type": [
            "schema:DownloadAction"
          ],
          "schema:name": "Download a single burst CDF granule by path",
          "schema:description": "Retrieve one CDF granule when its year, month, day, burst start time (YYYYMMDDhhmmss) and processing version are known. These are obtained from the file-listing action or the HAPI service.",
          "schema:target": {
            "@type": [
              "schema:EntryPoint"
            ],
            "schema:httpMethod": [
              "GET"
            ],
            "schema:contentType": [
              "application/x-cdf"
            ],
            "schema:urlTemplate": "https://lasp.colorado.edu/mms/sdc/public/data/mms4/hpca/brst/l2/ion/{year}/{month}/{day}/mms4_hpca_brst_l2_ion_{startTime}_v{version}.cdf"
          },
          "schema:query-input": [
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "year",
              "schema:description": "4-digit UTC year of the burst",
              "schema:valueRequired": true,
              "schema:valuePattern": "\\d{4}"
            },
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "month",
              "schema:description": "2-digit UTC month (01-12)",
              "schema:valueRequired": true,
              "schema:valuePattern": "0[1-9]|1[0-2]"
            },
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "day",
              "schema:description": "2-digit UTC day of month (01-31)",
              "schema:valueRequired": true,
              "schema:valuePattern": "0[1-9]|[12][0-9]|3[01]"
            },
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "startTime",
              "schema:description": "Burst start time as YYYYMMDDhhmmss (14 digits)",
              "schema:valueRequired": true,
              "schema:valuePattern": "\\d{14}"
            },
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "version",
              "schema:description": "Processing version, e.g. 4.1.0",
              "schema:valueRequired": true,
              "schema:valuePattern": "\\d+\\.\\d+\\.\\d+"
            }
          ]
        }
      ],
