    {
      "@type": [
        "schema:WebAPI"
      ],
      "schema:name": "MMS SDC file query API",
      "schema:description": "REST service that returns a JSON list of the granules matching a query (spacecraft, instrument, mode, level, descriptor, date range). Preferred machine-readable way to discover which burst granules exist on a given day, and to recover the exact granule filenames (start time + version) needed by the single-file download action. Confirm the exact parameter names against the SDC API documentation before relying on them.",
      "schema:termsOfService": "Open access (CC0-1.0). Please acknowledge S.A. Fuselier, D.T. Young, R.G. Gomez, and J.L. Burch, and the MMS SDC.",
      "schema:serviceType": {
        "@type": [
          "schema:DefinedTerm"
        ],
        "schema:name": "MMS Science Data Center file information API"
      },
      "schema:documentation": {
        "@type": [
          "schema:CreativeWork"
        ],
        "schema:name": "MMS SDC Web Services documentation",
        "schema:url": "https://lasp.colorado.edu/mms/sdc/public/about/how-to/"
      },
      "schema:potentialAction": [
        {
          "@type": [
            "schema:SearchAction"
          ],
          "schema:name": "List burst granules for a UTC day",
          "schema:description": "Return the list of HPCA burst L2 ion granules available for a single calendar day.",
          "schema:target": {
            "@type": [
              "schema:EntryPoint"
            ],
            "schema:httpMethod": [
              "GET"
            ],
            "schema:contentType": [
              "application/json"
            ],
            "schema:urlTemplate": "https://lasp.colorado.edu/mms/sdc/public/files/api/v1/file_info/science?sc_id=mms4&instrument_id=hpca&data_rate_mode=brst&data_level=l2&descriptor=ion&start_date={date}&end_date={date}"
          },
          "schema:result": {
            "@type": [
              "schema:DataDownload"
            ],
            "schema:name": "Granule list for the requested day",
            "schema:contentUrl": "https://lasp.colorado.edu/mms/sdc/public/files/api/v1/file_info/science?sc_id=mms4&instrument_id=hpca&data_rate_mode=brst&data_level=l2&descriptor=ion&start_date=2015-09-01&end_date=2015-09-01",
            "schema:encodingFormat": [
              "application/json"
            ]
          },
          "schema:query-input": [
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "date",
              "schema:description": "UTC calendar day as YYYY-MM-DD. Use 2015-09-01 as a test value.",
              "schema:valueRequired": true,
              "schema:valuePattern": "\\d{4}-\\d{2}-\\d{2}"
            }
          ]
        }
      ]
    },
    {
      "@id": "https://cdaweb.gsfc.nasa.gov/hapi",
      "@type": [
        "schema:WebAPI"
      ],
      "schema:name": "CDAWeb HAPI service",
      "schema:description": "Heliophysics API (HAPI) endpoint delivering this dataset as time-subsetted CSV based on a requested start/stop time. This is the recommended programmatic access route for the time series; the server does not require knowledge of individual granule filenames. The server reports HAPI 2.0 (https://cdaweb.gsfc.nasa.gov/hapi/capabilities; output formats: csv, json, binary).",
      "schema:termsOfService": "Open access (CC0-1.0). Please acknowledge the data providers and CDAWeb when using these data.",
      "schema:serviceType": {
        "@type": [
          "schema:DefinedTerm"
        ],
        "schema:name": "HAPI (Heliophysics Data Application Programmer's Interface) 2.0",
        "schema:termCode": "HAPI",
        "schema:version": "2.0"
      },
      "dcterms:conformsTo": [
        {
          "@id": "https://github.com/hapi-server/data-specification/blob/master/hapi-2.0.0/HAPI-data-access-spec-2.0.0.md"
        }
      ],
      "schema:documentation": [
        {
          "@type": [
            "schema:CreativeWork"
          ],
          "schema:name": "HAPI server capabilities (reports the supported spec version)",
          "schema:url": "https://cdaweb.gsfc.nasa.gov/hapi/capabilities"
        },
        {
          "@type": [
            "schema:CreativeWork"
          ],
          "schema:name": "HAPI /info - authoritative parameter/column definition for the CSV response",
          "schema:description": "Defines each CSV column (parameter name, type, size/array shape, units, fill). The CSV has no header row; this endpoint (and the companion WideDataStructure) is the column key. Note the HAPI parameter set differs from the CDF variables.",
          "schema:url": "https://cdaweb.gsfc.nasa.gov/hapi/info?id=MMS4_HPCA_BRST_L2_ION"
        }
      ],
      "schema:potentialAction": [
        {
          "@type": [
            "schema:SearchAction"
          ],
          "schema:name": "Retrieve data for a time range (HAPI)",
          "schema:description": "Return HPCA burst L2 ion data for the requested time interval as CSV.",
          "schema:target": {
            "@type": [
              "schema:EntryPoint"
            ],
            "schema:httpMethod": [
              "GET"
            ],
            "schema:contentType": [
              "text/csv"
            ],
            "schema:urlTemplate": "https://cdaweb.gsfc.nasa.gov/hapi/data?id=MMS4_HPCA_BRST_L2_ION&time.min={start}&time.max={end}"
          },
          "schema:result": {
            "@type": [
              "schema:DataDownload"
            ],
            "schema:name": "HAPI CSV response",
            "schema:contentUrl": "https://cdaweb.gsfc.nasa.gov/hapi/data?id=MMS4_HPCA_BRST_L2_ION&time.min=2015-09-01T12:11:00Z&time.max=2015-09-01T12:12:00Z",
            "schema:encodingFormat": [
              "text/csv"
            ]
          },
          "schema:query-input": [
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "start",
              "schema:description": "A UTC ISO date-time. Use 2015-09-01T12:11:00Z as a test start value.",
              "schema:valueRequired": true,
              "schema:valuePattern": "(-?(?:[1-9][0-9]*)?[0-9]{4})-(1[0-2]|0[1-9])-(3[01]|0[1-9]|[12][0-9])T(2[0-3]|[01][0-9]):([0-5][0-9]):([0-5][0-9])(.[0-9]+)?(Z)?"
            },
            {
              "@type": [
                "schema:PropertyValueSpecification"
              ],
              "schema:valueName": "end",
              "schema:description": "A UTC ISO date-time. Use 2015-09-01T12:12:00Z as a test end value.",
              "schema:valueRequired": true,
              "schema:valuePattern": "(-?(?:[1-9][0-9]*)?[0-9]{4})-(1[0-2]|0[1-9])-(3[01]|0[1-9]|[12][0-9])T(2[0-3]|[01][0-9]):([0-5][0-9]):([0-5][0-9])(.[0-9]+)?(Z)?"
            }
          ]
        }
      ]
    }
  ],
